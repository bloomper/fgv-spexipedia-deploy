DEPLOY_ENV=production
# Production uses no Cloudflare Tunnel: it sits behind its own reverse proxy (see README, Production)
COMPOSE_FILE=compose.yaml

# The web, with the images under /media/ on the same hostname; fgv-infra-deploy's .env names it SPEXIPEDIA_WEB_HOST
WEB_HOST=spexipedia.example.org
# The API's own hostname, for its MCP endpoint only; fgv-infra-deploy's .env names it SPEXIPEDIA_API_HOST
API_HOST=spexipedia-api.example.org
KEYCLOAK_HOST=auth.example.org
KEYCLOAK_REALM=fgv

API_IMAGE=bloomper/fgv-spexipedia-server:1.0.0
WEB_IMAGE=bloomper/fgv-spexipedia-web:1.0.0
MYSQL_IMAGE=mysql:8.4
NGINX_IMAGE=nginx:1.30-alpine

MYSQL_DATABASE=spexipedia
MYSQL_USER=spexipedia

# The other applications, on the shared network; each is optional: without it its links and photos are left out
SPEXREGISTER_GRAPHQL_URL=http://spexregister-api:8080/api/graphql
SPEXGRAM_GRAPHQL_URL=http://spexgram-api:8080/api/graphql
SPEXIFY_GRAPHQL_URL=http://spexify-api:8080/api/graphql
SPEXFLIX_GRAPHQL_URL=http://spexflix-api:8080/api/graphql
ARCHIVE_GRAPHQL_URL=http://archive-api:8080/api/graphql
SPEXREGISTER_WEB_URL=https://register.example.org
REVIVAL_WEB_URL=https://revival.example.org
SPEXIFY_WEB_URL=https://spexify.example.org
SPEXFLIX_WEB_URL=https://spexflix.example.org
SPEXGRAM_WEB_URL=https://spexgram.example.org
# Spexgram's MEDIA_HOST, as an origin: its photos and videos are shown on spex pages
SPEXGRAM_MEDIA_ORIGIN=https://spexgram-media.example.org
# The media of the other applications that spex pages show in sections of their own, as origins: Spexflix's
# MEDIA_HOST (videos), Spexify's API_HOST (audio and covers) and Spexarkivet's API_HOST (first-page previews)
SPEXFLIX_MEDIA_ORIGIN=https://spexflix-media.example.org
SPEXIFY_MEDIA_ORIGIN=https://spexify-api.example.org
ARCHIVE_MEDIA_ORIGIN=https://archive-api.example.org
ARCHIVE_WEB_URL=https://archive.example.org

API_IMPORT_SAMPLE_DATA=false
API_SAMPLE_DATA_SIZE=small

SUPPORTED_LOCALES=sv,en
DEFAULT_LOCALE=sv
SUPPORT_EMAIL=support.spexipedia@example.org
FEEDBACK_EMAIL=feedback.spexipedia@example.org
UMAMI_WEBSITE_ID=
