DEPLOY_ENV=staging
# Staging is reached through a Cloudflare Tunnel (see README, Staging)
COMPOSE_FILE=compose.yaml:compose.tunnel.yaml
# The Cloudflare Tunnel connector's image tag, pinned; upgrade it deliberately
CLOUDFLARED_VERSION=2026.11.0

# The web, with the images under /media/ on the same hostname; fgv-infra-deploy's .env names it SPEXIPEDIA_WEB_HOST
WEB_HOST=spexipedia-staging.example.org
KEYCLOAK_HOST=auth-staging.example.org
KEYCLOAK_REALM=fgv

API_IMAGE=bloomper/fgv-spexipedia-server:develop
WEB_IMAGE=bloomper/fgv-spexipedia-web:develop
MYSQL_IMAGE=mysql:8.4
NGINX_IMAGE=nginx:1.30-alpine

MYSQL_DATABASE=spexipedia
MYSQL_USER=spexipedia

# The other applications, on the shared network; each is optional: without it its links and photos are left out
SPEXREGISTER_GRAPHQL_URL=http://spexregister-api:8080/api/graphql
SPEXGRAM_GRAPHQL_URL=http://spexgram-api:8080/api/graphql
SPEXIFY_GRAPHQL_URL=http://spexify-api:8080/api/graphql
SPEXFLIX_GRAPHQL_URL=http://spexflix-api:8080/api/graphql
ARCHIVE_GRAPHQL_URL=http://archive-api:8080/api/graphql
SPEXREGISTER_WEB_URL=https://register-staging.example.org
REVIVAL_WEB_URL=https://revival-staging.example.org
SPEXIFY_WEB_URL=https://spexify-staging.example.org
SPEXFLIX_WEB_URL=https://spexflix-staging.example.org
SPEXGRAM_WEB_URL=https://spexgram-staging.example.org
# Spexgram's MEDIA_HOST (its Tailscale Funnel name), as an origin: its photos and videos are shown on spex pages
SPEXGRAM_MEDIA_ORIGIN=https://spexgram-media-staging.tail1234.ts.net
ARCHIVE_WEB_URL=https://archive-staging.example.org

API_IMPORT_SAMPLE_DATA=true
API_SAMPLE_DATA_SIZE=small

SUPPORTED_LOCALES=sv,en
DEFAULT_LOCALE=sv
SUPPORT_EMAIL=support.spexipedia@example.org
FEEDBACK_EMAIL=feedback.spexipedia@example.org
UMAMI_WEBSITE_ID=
